; Battle prototype — Godot 4.6
config_version=5

[application]
config/name="EMBER / 戦闘試験場"
config/use_custom_user_dir=true
config/custom_user_dir_name="EmberBattlePrototype"
config/use_custom_user_dir=true
config/custom_user_dir_name="EmberBattlePrototype"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")

[display]
window/size/viewport_width=1440
window/size/viewport_height=960
window/size/window_width_override=1280
window/size/window_height_override=854
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
environment/defaults/default_clear_color=Color(0.035, 0.047, 0.069, 1)
